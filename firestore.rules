rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // ให้สิทธิ์อ่านและเขียนตลอดไป (ไม่หมดอายุ)
    // หากมีการใช้ Firebase Authentication แนะนำเปลี่ยน write เป็น: if request.auth != null;
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
